{
  "name": "pi-self-reflect",
  "version": "0.1.0",
  "description": "Pi extension that runs periodic self-reflection checkpoints to detect loops, drift, weak assumptions, or stalled progress.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgint/pi-self-reflect.git"
  },
  "author": "cgint",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "self-reflection",
    "checkpoint",
    "guardrail"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "precommit": "tsc --noEmit && npm run test && npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^22.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.0.0"
  }
}